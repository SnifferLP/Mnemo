{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mnemo",
  "version": "1.2.4",
  "identifier": "com.mnemo.study",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mnemo",
        "width": 1440,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "The Mnemo Authors",
    "copyright": "Copyright (c) 2026 The Mnemo Authors",
    "homepage": "https://github.com/SnifferLP/Mnemo",
    "category": "Education",
    "shortDescription": "Offline-first AI study platform",
    "longDescription": "Mnemo is a local-first study platform with flashcards, spaced repetition, adaptive learning, tests, and configurable AI assistance.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMkU3MzZDQTgzNjE2RkMKUldUOEZqYW9iSE11V2kxSWpXdXZMbGZaTm8xY3BydDM2bjFrM0NjaWpnak1raFkrOUZFZ1NPckIK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
